<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0A0E1A">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="RAKSHAK AI"
            android:textColor="#4D7CFF"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="On-Device Phishing &amp; Fraud Defence Assistant"
            android:textColor="#A8B6CC"
            android:textSize="13sp"
            android:layout_marginBottom="24dp" />

        <TextView
            android:id="@+id/tvProtectionStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#1B2438"
            android:padding="16dp"
            android:text="🛡️ ON-DEVICE PROTECTION: ACTIVE"
            android:textColor="#34D399"
            android:textSize="14sp"
            android:textStyle="bold"
            android:layout_marginBottom="24dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Required Permissions for Zero-Copy Protection:"
            android:textColor="#F4F7FD"
            android:textSize="14sp"
            android:textStyle="bold"
            android:layout_marginBottom="12dp" />

        <Button
            android:id="@+id/btnGrantNotificationAccess"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:backgroundTint="#4D7CFF"
            android:text="1. Grant WhatsApp/SMS Notification Listener"
            android:layout_marginBottom="12dp" />

        <Button
            android:id="@+id/btnGrantOverlayAccess"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:backgroundTint="#2E6BFF"
            android:text="2. Grant Floating Alert Shield Overlay"
            android:layout_marginBottom="24dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Manual Threat Scanner"
            android:textColor="#F4F7FD"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Check a suspicious website URL (e.g. sbi-bank-kyc-update.top)"
            android:textColor="#A8B6CC"
            android:textSize="12sp"
            android:layout_marginBottom="4dp" />

        <EditText
            android:id="@+id/etUrlInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#1B2438"
            android:padding="12dp"
            android:textColor="#FFFFFF"
            android:textColorHint="#5B6B85"
            android:hint="Paste URL here"
            android:inputType="textUri"
            android:layout_marginBottom="8dp" />

        <Button
            android:id="@+id/btnScanUrl"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:backgroundTint="#4D7CFF"
            android:text="Scan URL"
            android:layout_marginBottom="16dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Check a UPI QR / payment code (upi://pay?... or VPA e.g. cashback-claim@ybl)"
            android:textColor="#A8B6CC"
            android:textSize="12sp"
            android:layout_marginBottom="4dp" />

        <EditText
            android:id="@+id/etUpiInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#1B2438"
            android:padding="12dp"
            android:textColor="#FFFFFF"
            android:textColorHint="#5B6B85"
            android:hint="Paste UPI payload or VPA here"
            android:inputType="text"
            android:layout_marginBottom="8dp" />

        <Button
            android:id="@+id/btnScanUpi"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:backgroundTint="#4D7CFF"
            android:text="Scan UPI / QR"
            android:layout_marginBottom="16dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Check an APK URL or package name (e.g. com.sbi.kyc.verification.doc)"
            android:textColor="#A8B6CC"
            android:textSize="12sp"
            android:layout_marginBottom="4dp" />

        <EditText
            android:id="@+id/etApkInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#1B2438"
            android:padding="12dp"
            android:textColor="#FFFFFF"
            android:textColorHint="#5B6B85"
            android:hint="Paste APK URL or package name here"
            android:inputType="text"
            android:layout_marginBottom="8dp" />

        <Button
            android:id="@+id/btnScanApk"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:backgroundTint="#4D7CFF"
            android:text="Scan APK"
            android:layout_marginBottom="16dp" />

        <TextView
            android:id="@+id/tvScanResult"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#1B2438"
            android:padding="16dp"
            android:textColor="#E2E8F0"
            android:textSize="13sp"
            android:visibility="gone" />

    </LinearLayout>
</ScrollView>
